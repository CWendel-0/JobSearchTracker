<Window x:Class="JobTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JobTracker.App.ViewModels"
        Title="Job Application Tracker"
        Height="660" Width="1140"
        MinHeight="520" MinWidth="860"
        Background="{StaticResource SurfaceBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>    <!-- Header bar    -->
            <RowDefinition Height="52"/>    <!-- Toolbar       -->
            <RowDefinition Height="*"/>     <!-- Results grid  -->
            <RowDefinition Height="Auto"/>  <!-- Footer        -->
        </Grid.RowDefinitions>

        <!-- ══ Header bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="16,0">
                <TextBlock Text="Job Application Tracker"
                           Foreground="White" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Content="⚙  Settings"
                        Command="{Binding OpenSettingsCommand}"
                        HorizontalAlignment="Right"
                        Padding="12,6"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="#80FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Toolbar ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶  Fetch New Jobs"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding FetchCommand}"
                            Width="155"/>

                    <ProgressBar IsIndeterminate="True"
                                 Width="120" Height="3"
                                 Margin="16,0,0,0"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsFetching,
                                     Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource SubtextBrush}"
                           FontSize="12"/>
            </Grid>
        </Border>

        <!-- ══ Results DataGrid ═══════════════════════════════════════════════ -->
        <DataGrid Grid.Row="2"
                  x:Name="ResultsGrid"
                  ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  BorderThickness="0"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFAFA"
                  ColumnHeaderHeight="36"
                  RowHeight="34"
                  FontSize="12"
                  HeadersVisibility="Column">

            <!-- Yellow highlight for rows where experience was not stated -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource FlaggedRowBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"       Value="#F1F3F4"/>
                    <Setter Property="Foreground"       Value="{StaticResource SubtextBrush}"/>
                    <Setter Property="FontWeight"       Value="SemiBold"/>
                    <Setter Property="Padding"          Value="8,0"/>
                    <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness"  Value="0,0,0,1"/>
                    <Setter Property="Height"           Value="36"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <!-- Include checkbox -->
                <DataGridTemplateColumn Header="✓" Width="38" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected,
                                          UpdateSourceTrigger=PropertyChanged,
                                          Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Company -->
                <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"          Value="8,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming"     Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Job Title -->
                <DataGridTextColumn Header="Job Title" Binding="{Binding Title}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"          Value="8,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming"     Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Posted date -->
                <DataGridTextColumn Header="Posted" Binding="{Binding PostingDateDisplay}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"           Value="8,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Source -->
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"          Value="8,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Experience level -->
                <DataGridTextColumn Header="Level" Binding="{Binding LevelDisplay}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"             Value="8,0"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Experience flag -->
                <DataGridTemplateColumn Header="⚠" Width="36"
                                        CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="⚠"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding FlagTooltip}"
                                       Visibility="{Binding IsFlagged,
                                           Converter={StaticResource BoolToVisibility}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Open URL -->
                <DataGridTemplateColumn Header="Link" Width="60"
                                        CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="{Binding Url}"
                                           RequestNavigate="Hyperlink_RequestNavigate"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    Open ↗
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ Footer ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>

                <!-- Left: summary text + flag legend -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}"
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="⚠ = experience requirement not stated — included for your review"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasResults,
                                   Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <!-- Right: action buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="Select All"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SelectAllCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding HasResults,
                                Converter={StaticResource BoolToVisibility}}"/>

                    <Button Content="Deselect All"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding DeselectAllCommand}"
                            Margin="0,0,16,0"
                            Visibility="{Binding HasResults,
                                Converter={StaticResource BoolToVisibility}}"/>

                    <Button Content="{Binding AddToSheetButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddToSheetCommand}"
                            MinWidth="210"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>
